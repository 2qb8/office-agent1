# Optional AI planner configuration.
#
# Easiest: run "python run.py ai setup", which writes config/.env for you.
# The deterministic engine (python run.py <job>) needs none of these.
#
# Providers: openai, gemini, openrouter, ollama (local), custom.
# A local model with no account:
#   ollama serve && ollama pull qwen2.5:3b
#   python run.py ai setup --provider ollama

LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_FALLBACK_MODELS=
LLM_MAX_ATTEMPTS=5
LLM_RETRY_BASE_SECONDS=2
LLM_RETRY_MAX_SECONDS=30
